# Copy to .env and fill in for production. `pnpm dev` supplies local defaults
# when these are unset (NODE_ENV=development).

# Absolute path to the Library tree. Dev default: <cwd>/data/library
LIBRARY_ROOT=

# Writable app data dir. SQLite lives here and must never be under the Library.
# Dev default: <cwd>/data/app
SPINBOX_DATA_DIR=

# Sole canonical origin (scheme+host[+port]) for cookies, redirects, and links.
# Production must set this. Do not invent origin from Host / X-Forwarded-*.
# Dev default: http://127.0.0.1:<port>
SPINBOX_PUBLIC_URL=

# Loopback listen port behind Tailscale Serve. Dev default: 44100
PORT=44100
# SPINBOX_PORT=44100

# Signs the Household member session cookie. Production must set this.
# Dev default: a well-known local secret (not for production).
SESSION_SECRET=
