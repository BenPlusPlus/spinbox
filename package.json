{
  "name": "spinbox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "start": "cross-env NODE_ENV=production node --import remix/node-tsx server.ts",
    "migrate": "node --import remix/node-tsx app/data/migrate.ts",
    "recover-admin": "node --import remix/node-tsx app/modules/auth/recover-admin.ts",
    "test": "cross-env NODE_ENV=test node --import remix/node-tsx --test",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "music-metadata": "11.15.0",
    "remix": "3.0.0-beta.5"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "cross-env": "10.1.0",
    "typescript": "5.9.3"
  }
}
